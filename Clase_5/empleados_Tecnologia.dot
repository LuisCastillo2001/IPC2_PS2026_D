digraph Empleados_Tecnologia {
  label="Lista Doblemente Circular - Empleados de Tecnologia";
  labelloc="t";
  fontsize=16;
  fontname="Arial Bold";
  rankdir=LR;
  splines=curved;
  nodesep=1.5;
  bgcolor="white";

  node [shape=record, style="filled,rounded", fillcolor="#4BC8C8", fontname="Arial Bold", fontsize=12, color="#E8A020", penwidth=3, height=0.8];
  edge [penwidth=2, fontname="Arial", fontsize=9];

  emp_Tecnologia_Luis [label="{ Luis | Gerente | Q1000 }"];
  emp_Tecnologia_Andrea [label="{ Andrea | Auditora | Q4941 }"];
  emp_Tecnologia_Juan [label="{ Juan | Auxiliar | Q2500 }"];

  emp_Tecnologia_Luis -> emp_Tecnologia_Andrea [color="#333333", arrowhead=vee];
  emp_Tecnologia_Andrea -> emp_Tecnologia_Juan [color="#333333", arrowhead=vee];

  emp_Tecnologia_Andrea -> emp_Tecnologia_Luis [color="#333333", arrowhead=vee, constraint=false, dir = back];
  emp_Tecnologia_Juan -> emp_Tecnologia_Andrea [color="#333333", arrowhead=vee, constraint=false, dir = back];

  emp_Tecnologia_Juan -> emp_Tecnologia_Luis [color="#333333", arrowhead=vee, constraint=false, tailport=s, headport=s, style=bold, dir=back];

  emp_Tecnologia_Luis -> emp_Tecnologia_Juan [color="#333333", arrowhead=vee, constraint=false, tailport=n, headport=n, style=bold];
}
