@page "/drones"
@using Clase_8.Servicios
@model DronesModel
@{
    ViewData["Title"] = "Sistema de Drones - USAC";
}

<div class="container mt-4">
    <h1>🚁 Sistema de Drones de Defensa - USAC</h1>
    <p class="lead">Gestión de drones para transmisión de mensajes encriptados usando listas enlazadas</p>

    <hr />

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5>Cargar Configuración</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="CargarXml">
                        <div class="mb-3">
                            <label for="rutaArchivo" class="form-label">Ruta del archivo XML:</label>
                            <input type="text" class="form-control" id="rutaArchivo" name="rutaArchivo" 
                                   value="Data/drones_config.xml" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-upload"></i> Cargar XML
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5>Exportar Visualización</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="ExportarGraphviz">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-download"></i> Exportar Graphviz (PNG)
                        </button>
                    </form>
                    <p class="text-muted small mt-2">Se guardará en: <code>/wwwroot/grafos/</code></p>
                </div>
            </div>
        </div>
    </div>

    <hr />

    @if (!string.IsNullOrEmpty(Model.MensajeEstado))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <strong>Estado:</strong> @Model.MensajeEstado
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @Model.MensajeError
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- TABLA DE DRONES -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Lista de Drones (Estructura Enlazada)</h5>
                </div>
                <div class="card-body">
                    @if (Model.ListaDronesActual?.Raiz == null)
                    {
                        <div class="alert alert-warning alert-dismissible">
                            <strong>Sin datos</strong> - Cargue un archivo XML para ver la lista de drones.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 60px">#</th>
                                        <th>Nombre del Dron</th>
                                        <th style="width: 120px">Altura Actual</th>
                                        <th style="width: 120px">Altura Máx</th>
                                        <th style="width: 130px">Estado Luz</th>
                                        <th style="width: 180px">Progreso Altura</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var nodo = Model.ListaDronesActual.Raiz;
                                        int indice = 1;
                                        while (nodo != null)
                                        {
                                            var dron = nodo.Dron;
                                            int porcentaje = dron.AlturaMaxima > 0 ? (int)((dron.AlturaActual * 100) / dron.AlturaMaxima) : 0;
                                            string colorAlerta = porcentaje > 80 ? "danger" : porcentaje > 60 ? "warning" : "success";
                                            <tr>
                                                <td><span class="badge bg-primary rounded-pill">@indice</span></td>
                                                <td><strong>@dron.Nombre</strong></td>
                                                <td class="text-center">
                                                    <span class="badge bg-light text-dark">@dron.AlturaActual m</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-light text-dark">@dron.AlturaMaxima m</span>
                                                </td>
                                                <td class="text-center">
                                                    @if (dron.LuzActiva)
                                                    {
                                                        <span class="badge bg-success px-3">
                                                            <i class="bi bi-lightbulb-fill"></i> ENCENDIDA
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary px-3">
                                                            <i class="bi bi-lightbulb"></i> APAGADA
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="progress" style="height: 25px;">
                                                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-@colorAlerta"
                                                             role="progressbar" 
                                                             style="width: @porcentaje%;" 
                                                             aria-valuenow="@porcentaje" 
                                                             aria-valuemin="0" 
                                                             aria-valuemax="100">
                                                            <small>@porcentaje%</small>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                            nodo = nodo.Siguiente;
                                            indice++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ESTADÍSTICAS E INFORMACIÓN -->
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Estadísticas</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-muted">Total de Drones:</h6>
                        <h2 class="text-success">@Model.TotalDrones</h2>
                    </div>
                    <hr />
                    <div>
                        <h6 class="text-muted">Sistemas Cargados:</h6>
                        <h2 class="text-info">@Model.TotalSistemas</h2>
                    </div>
                </div>
            </div>
        </div>

        
    </div>

    <!-- GRAFO VISUALIZACIÓN -->
    <div class="row mt-4" style="display:@(Model.MostrarGrafo ? "block" : "none");">
        <div class="col-12">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Visualización del Grafo - Estructura de Drones</h5>
                </div>
                <div class="card-body text-center" style="background-color: #f8f9fa;">
                    <img src="~/grafos/drones_grafo.png" alt="Grafo de Drones" class="img-fluid rounded" style="max-height: 500px;" />
                </div>
            </div>
        </div>
    </div>

    <!-- CÓDIGO GRAPHVIZ -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Código DOT (Graphviz)</h5>
                </div>
                <div class="card-body">
                    <pre style="background-color: #1e1e1e; color: #d4d4d4; padding: 15px; border-radius: 6px; overflow-x: auto; font-size: 0.9rem;">@Model.CodigoGraphviz</pre>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }
    .card {
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        border: none;
    }
    .card-header {
        font-weight: 600;
        border-bottom: 2px solid rgba(0,0,0,0.1);
    }
    .table-responsive {
        border-radius: 6px;
        overflow: hidden;
    }
    .progress {
        border-radius: 4px;
        background-color: #e9ecef;
    }
    .badge {
        font-size: 0.85rem;
        padding: 0.5rem 0.8rem;
    }
    h1 {
        color: #2c3e50;
        font-weight: 700;
        margin-bottom: 10px;
    }
    .lead {
        color: #7f8c8d;
        font-size: 1.1rem;
    }
</style>
